# Copie para .env (NAO commitar) e preencha.
# Usado pelo docker-compose.yml e, se quiser, exportado antes do ./mvnw spring-boot:run

SPRING_PROFILES_ACTIVE=prod
DB_USER=sobraboa
DB_PASSWORD=troque-esta-senha

# minimo 32 caracteres, aleatorio (ex.: openssl rand -base64 48)
JWT_SECRET=

# conta do administrador criada na subida
ADMIN_EMAIL=admin@sobraboa.com
ADMIN_SENHA=troque-esta-senha

# chave do provedor de LLM (sem ela a API sobe, mas o assistente de IA responde 503)
OPENAI_API_KEY=

CORS_ALLOWED_ORIGINS=*
SWAGGER_ENABLED=true